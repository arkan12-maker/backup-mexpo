# ============================================================
# MEXPO ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to `.env` and fill in your real credentials.
# ============================================================

# ------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------
DB_PROVIDER=postgresql
DB_HOST=postgres
DB_PORT=5432
DB_PORT_HOST=5433
DB_USER=mexpo_user
DB_PASSWORD=your_secure_db_password_here
DB_NAME=mexpo_db
DB_SSLMODE=

# ------------------------------------------------------------
# 2. BACKEND APP CONFIGURATION (NestJS)
# ------------------------------------------------------------
BACKEND_PORT=3500
NODE_ENV=production
JWT_SECRET=your_jwt_secret_key_here
BASIC_AUTH_USERNAME=mexpo_admin
BASIC_AUTH_PASSWORD=your_secure_basic_auth_password_here
PUBLIC_FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:3500

# ------------------------------------------------------------
# 3. SMTP MAIL CONFIGURATION
# ------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your_email@example.com
MAIL_PASSWORD=your_app_password
CONTACT_DESTINATION_EMAIL=contact@example.com

# ------------------------------------------------------------
# 4. OBJECT STORAGE (MinIO / S3)
# ------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_minio_admin_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

MINIO_ENDPOINT=http://localhost:9000
MINIO_ENDPOINT_UPLOAD=http://minio:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=expo-project
AWS_REGION=us-east-1

# ------------------------------------------------------------
# 5. FRONTEND APP CONFIGURATION (Next.js)
# ------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_BASE_URL_DEVELOPMENT=http://backend:3500
NEXT_PUBLIC_BASE_URL_PRODUCTION=http://localhost:3500
NEXT_PUBLIC_BASIC_AUTH_USERNAME=mexpo_admin
NEXT_PUBLIC_BASIC_AUTH_PASSWORD=your_secure_basic_auth_password_here
NEXT_PUBLIC_TOKEN_KEY=mexpo-token

# ------------------------------------------------------------
# 6. PAYMENT GATEWAY (Midtrans Snap)
# ------------------------------------------------------------
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_CLIENT_KEY=your_midtrans_client_key
MIDTRANS_IS_3DS=true
MIDTRANS_PAYMENT_EXPIRY=1440
PAYMENT_PLATFORM_FEE_PERCENT=5

NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=your_midtrans_client_key
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# ------------------------------------------------------------
# 7. GOOGLE OAUTH
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ------------------------------------------------------------
# 8. PARTNER INTEGRATION
# ------------------------------------------------------------
MEXPO_INTEGRATION_API_KEY=your_integration_api_key
MEXPO_WEBHOOK_SECRET=your_webhook_secret

# ------------------------------------------------------------
# 9. CI/CD & AWS ECR DOCKER IMAGES (GitHub Actions & Deployment)
# ------------------------------------------------------------
TAG=latest
ECR_BACKEND_IMAGE=331235584925.dkr.ecr.ap-southeast-2.amazonaws.com/mexpo-be
ECR_FRONTEND_IMAGE=331235584925.dkr.ecr.ap-southeast-2.amazonaws.com/mexpo-fe
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-southeast-2

# ------------------------------------------------------------
# 10. EC2 HOST & DEPLOYMENT SERVER CONFIGURATION
# ------------------------------------------------------------
EC2_HOST=your_ec2_ip_or_domain
EC2_USER=ubuntu
EC2_PORT=22
# EC2_SSH_KEY: Put your private SSH Key (.pem) in GitHub Actions secret EC2_SSH_KEY
# Or define here if deploying via automated scripts (can be multiline or single line):
# EC2_SSH_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
